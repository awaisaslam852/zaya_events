{
  "name": "zaya-events",
  "version": "0.1.0",
  "private": true,
  "description": "Zaya Events — event planning, discovery, inquiry, booking, travel, and management platform",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @zaya/api dev",
    "dev:admin": "pnpm --filter @zaya/admin-web dev",
    "dev:vendor": "pnpm --filter @zaya/vendor-web dev",
    "build": "pnpm -r --filter \"./apps/**\" build",
    "build:api": "pnpm --filter @zaya/api build",
    "lint": "pnpm -r --filter \"./apps/**\" lint",
    "typecheck": "pnpm -r --filter \"./apps/**\" typecheck",
    "test": "pnpm --filter @zaya/api test",
    "test:api": "pnpm --filter @zaya/api test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @zaya/api prisma:generate",
    "db:migrate": "pnpm --filter @zaya/api prisma:migrate",
    "db:seed": "pnpm --filter @zaya/api prisma:seed",
    "db:studio": "pnpm --filter @zaya/api prisma:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
