# ── Runtime ──────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
ADMIN_WEB_URL=http://localhost:5173
VENDOR_WEB_URL=http://localhost:5174
CUSTOMER_APP_DEEP_LINK=zaya://reset-password
# Admin + vendor Vite ports. Flutter web uses a random localhost port; the API
# allows any http(s) localhost / 127.0.0.1 origin when NODE_ENV is not production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080,http://127.0.0.1:8080

# ── PostgreSQL ───────────────────────────────────────
POSTGRES_USER=zaya
POSTGRES_PASSWORD=zaya_dev_password
POSTGRES_DB=zaya_events
DATABASE_URL=postgresql://zaya:zaya_dev_password@localhost:5432/zaya_events?schema=public

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Password hashing ─────────────────────────────────
BCRYPT_ROUNDS=12

# ── Rate limit ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ── Storage (pluggable hosting — NO AWS SDK) ─────────
# Drivers: local | sftp | ftp | spaces | custom
STORAGE_DRIVER=local
STORAGE_PUBLIC_URL=http://localhost:4000
STORAGE_LOCAL_DIR=./uploads

SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_BASE_PATH=/uploads

FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false
FTP_BASE_PATH=/uploads

# S3-compatible (DigitalOcean Spaces / MinIO / Wasabi) via "minio" npm only
SPACES_ENDPOINT=
SPACES_PORT=443
SPACES_USE_SSL=true
SPACES_BUCKET=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
SPACES_REGION=us-east-1
SPACES_PUBLIC_URL=

CUSTOM_STORAGE_UPLOAD_URL=
CUSTOM_STORAGE_DELETE_URL=
CUSTOM_STORAGE_API_KEY=

# ── Agora (certificate NEVER leaves the server) ──────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRES_IN=3600

# ── Stripe (provider interface; keys from env only) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
VAT_RATE=5
WHATSAPP_NOTIFY_ENABLED=true

# ── Firebase Cloud Messaging ─────────────────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── Integration providers (mock | real). One line each. ──
FLIGHTS_PROVIDER=mock
HOTELS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
OPENAI_PROVIDER=mock
MAPS_PROVIDER=mock

# Amadeus (used when FLIGHTS_PROVIDER=amadeus)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test
DUFFEL_ACCESS_TOKEN=

# Booking.com Demand API (used when HOTELS_PROVIDER=bookingcom)
BOOKINGCOM_API_KEY=
BOOKINGCOM_AFFILIATE_ID=
EXPEDIA_API_KEY=
EXPEDIA_SHARED_SECRET=

# ── WhatsApp Cloud API ───────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
CALLS_WHATSAPP_ENABLED=false

# ── Email (SMTP) ─────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Zaya Events <noreply@zayaevents.local>

# ── OpenAI ───────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Google Maps ──────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Seed ─────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@zayaevents.com
SEED_ADMIN_PASSWORD=ChangeMeAdmin!123
SEED_VENDOR_PASSWORD=ChangeMeVendor!123
